# =============================================================================
# Job Hunter — Local (NO DOCKER)
# =============================================================================

APP_NAME=Job Hunter
SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-64-chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Groq AI (OpenAI-compatible) — cover letters, resume optimizer, interview prep
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: OpenAI instead of Groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Live job sources
REFRESH_JOBS_ON_STARTUP=true
# Pakistan: Indeed PK + Rozee.pk scraping (requires curl_cffi)
ENABLE_PAKISTAN_SCRAPING=true
ENABLE_LINKEDIN_SCRAPING=true

# Optional: JSearch RapidAPI — strong Pakistan coverage via Google Jobs/Indeed
JSEARCH_RAPIDAPI_KEY=

JOB_FETCH_LIMIT_PER_SOURCE=200

# Optional: Adzuna (free at https://developer.adzuna.com) — US, UK, DE, IN, etc.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: Jooble (free at https://jooble.org/api/about) — aggregates Indeed, LinkedIn, Monster
JOOBLE_API_KEY=

# Optional: Careerjet (https://www.careerjet.com/partners/api) — global search
CAREERJET_API_KEY=

ENABLE_SCHEDULER=true
JOB_REFRESH_MINUTES=60

# Optional: true background phone notifications. Requires HTTPS on the phone.
# Generate a VAPID key pair and place the URL-safe public/private values here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: USAJobs (US federal jobs)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=JavaCareerAI/1.0

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
